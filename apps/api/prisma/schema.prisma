generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARTICIPANT
  ORGANIZER
  MODERATOR
  RECEPTION
  ADMIN
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FULL
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING_CALL
  CALL_SCHEDULED
  CALL_COMPLETED
  ACCEPTED
  REFUSED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum QuotaCategory {
  HOMME
  FEMME
}

enum AlternativeOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model User {
  id               String           @id @default(cuid())
  phone            String           @unique
  email            String?          @unique
  displayName      String
  role             UserRole         @default(PARTICIPANT)
  suspendedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          Profile?
  ownedRestaurant  Restaurant?      @relation("Owner")
  restaurantId     String?
  restaurant       Restaurant?      @relation("StaffOf", fields: [restaurantId], references: [id])
  applications     Application[]
  reservations     Reservation[]
  waitlistEntries  WaitlistEntry[]
  sentRequests     ContactRequest[] @relation("requester")
  receivedRequests ContactRequest[] @relation("recipient")
  conversationMembers ConversationMember[]
  messages         Message[]
  reportsMade      Report[]         @relation("reporter")
  reportsReceived  Report[]         @relation("reported")
  notifications    Notification[]
  loyaltyEntries   LoyaltyEntry[]
  alternativeOffers AlternativeOffer[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate       DateTime?
  city            String?
  profession      String?
  interests       String[]
  bio             String?
  photoUrl        String?
  shareCode       String   @unique @default(cuid())
  profileCompleted Boolean @default(false)
  quotaCategory   QuotaCategory?
  validatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Restaurant {
  id               String           @id @default(cuid())
  ownerId          String           @unique
  owner            User             @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff            User[]           @relation("StaffOf")
  name             String
  description      String?
  district         String?
  address          String?
  phone            String?
  commissionRate   Int              @default(15)
  status           RestaurantStatus @default(APPROVED)
  submittedAt      DateTime         @default(now())
  verifiedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  controlledEvents Event[]          @relation("Controller")
  hostedEvents     Event[]          @relation("Venue")
  @@map("Organizer")
}

model Event {
  id                      String      @id @default(cuid())
  slug                    String      @unique
  controllerRestaurantId  String?     @map("organizerId")
  controllerRestaurant    Restaurant? @relation("Controller", fields: [controllerRestaurantId], references: [id])
  venueRestaurantId       String?
  venueRestaurant         Restaurant? @relation("Venue", fields: [venueRestaurantId], references: [id])
  title                   String
  category                String
  imageUrl                String?
  description             String
  startsAt                DateTime
  endsAt                  DateTime
  district                String
  address                 String
  zone                    String?
  capacity                Int
  priceCents              Int
  status                  EventStatus @default(DRAFT)
  submittedForReviewAt    DateTime?
  reviewedAt              DateTime?
  reviewNote              String?
  applications            Application[]
  callSlots               ScreeningCall[]
  reservations            Reservation[]
  waitlist                WaitlistEntry[]
  quotas                  EventQuota[]
  originalOffers          AlternativeOffer[] @relation("OriginalEvent")
  alternativeOffers       AlternativeOffer[] @relation("AlternativeEvent")
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model EventQuota {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category  QuotaCategory
  capacity  Int
  heldCount Int           @default(0)
  @@unique([eventId, category])
}

model Application {
  id          String            @id @default(cuid())
  eventId     String
  userId      String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  motivation  String
  notes       String?
  status      ApplicationStatus @default(PENDING_CALL)
  quotaCategory QuotaCategory?
  decidedAt   DateTime?
  call        ScreeningCall?
  reservation Reservation?
  waitlistEntry WaitlistEntry?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@unique([eventId, userId])
}

model ScreeningCall {
  id            String       @id @default(cuid())
  eventId       String
  applicationId String?      @unique
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  completedAt   DateTime?
  notes         String?
}

model Reservation {
  id            String       @id @default(cuid())
  eventId       String
  userId        String
  applicationId String       @unique
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application  @relation(fields: [applicationId], references: [id])
  quotaCategory QuotaCategory?
  expiresAt     DateTime
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  payment       Payment?
  ticket        Ticket?
  alternativeOffer AlternativeOffer?
  createdAt     DateTime     @default(now())
  @@unique([eventId, userId])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  provider      String        @default("fake")
  providerRef   String?
  paidAt        DateTime?
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String       @unique
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  code          String       @unique
  status        TicketStatus @default(VALID)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
}

model WaitlistEntry {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  applicationId String   @unique
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id])
  quotaCategory QuotaCategory?
  position      Int
  offeredAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  @@unique([eventId, userId])
}

model AlternativeOffer {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalEventId    String
  originalEvent      Event                  @relation("OriginalEvent", fields: [originalEventId], references: [id], onDelete: Cascade)
  alternativeEventId String
  alternativeEvent   Event                  @relation("AlternativeEvent", fields: [alternativeEventId], references: [id], onDelete: Cascade)
  status             AlternativeOfferStatus @default(PENDING)
  respondsBy         DateTime
  reservationId      String?                @unique
  reservation        Reservation?           @relation(fields: [reservationId], references: [id])
  createdAt          DateTime               @default(now())
  respondedAt        DateTime?
}

model ContactRequest {
  id          String               @id @default(cuid())
  requesterId String
  recipientId String
  requester   User                 @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                 @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      ContactRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@unique([requesterId, recipientId])
}

model Conversation {
  id        String               @id @default(cuid())
  members   ConversationMember[]
  messages  Message[]
  createdAt DateTime             @default(now())
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  blockedAt      DateTime?
  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String?
  imageUrl       String?
  createdAt      DateTime     @default(now())
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User         @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model LoyaltyEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model OutboxMessage {
  id        String   @id @default(cuid())
  channel   String
  recipient String
  subject   String?
  body      String
  createdAt DateTime @default(now())
}
