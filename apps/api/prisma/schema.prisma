generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARTICIPANT
  ORGANIZER
  MODERATOR
  RECEPTION
  ADMIN
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FULL
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING_CALL
  CALL_SCHEDULED
  CALL_COMPLETED
  ACCEPTED
  REFUSED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum QuotaCategory {
  HOMME
  FEMME
}

enum AlternativeOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Détermine le parcours d'inscription d'un événement de façon explicite et centralisée (voir
// eventRequiresScreening dans packages/shared), jamais par comparaison de la catégorie affichée
// (texte libre, configurable) : SCREENING exige le profil validé et un questionnaire privé avant
// paiement ; DIRECT autorise le paiement immédiat après un questionnaire non bloquant.
enum EventFlow {
  SCREENING
  DIRECT
}

// Décision prise sur un événement dont le minimum de participants n'était pas atteint à la date
// limite (§10) : par le restaurateur explicitement, ou par défaut (MAINTAIN, voir AppSetting
// MIN_PARTICIPANTS_NO_RESPONSE_ACTION) s'il ne répond pas dans le délai.
enum MinParticipantsOutcome {
  MAINTAINED
  CANCELLED
}

model User {
  id               String           @id @default(cuid())
  // Connexion par Google ou par e-mail depuis le 2026-09-24 : le numéro n'est plus obligatoire à la
  // création du compte. Il est vérifié une seule fois par SMS (phoneVerifiedAt) avant la première
  // inscription à une soirée — jamais redemandé à chaque connexion, pour limiter le coût des SMS.
  phone            String?          @unique
  phoneVerifiedAt  DateTime?
  email            String?          @unique
  emailVerifiedAt  DateTime?
  // E-mail de bienvenue envoyé une seule fois, dès la première adresse vérifiée (décision v2 §4).
  welcomeEmailSentAt DateTime?
  displayName      String
  role             UserRole         @default(PARTICIPANT)
  suspendedAt      DateTime?
  // Suppression RGPD (§20) : jamais une ligne supprimée (cascaderait sur Payment/LedgerEntry, dont la
  // conservation est légalement obligatoire), seulement anonymisée — voir anonymizeUser() côté API.
  deletedAt        DateTime?
  // Données de démonstration (lancement) : compte propriétaire d'un restaurant de démonstration,
  // jamais signalé comme tel à l'écran mais identifiable sans ambiguïté pour une suppression
  // ultérieure (voir aussi Restaurant.isDemo et Event.isDemo).
  isDemo           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profile          Profile?
  ownedRestaurant  Restaurant?      @relation("Owner")
  restaurantId     String?
  restaurant       Restaurant?      @relation("StaffOf", fields: [restaurantId], references: [id])
  applications     Application[]
  reservations     Reservation[]
  waitlistEntries  WaitlistEntry[]
  sentRequests     ContactRequest[] @relation("requester")
  receivedRequests ContactRequest[] @relation("recipient")
  conversationMembers ConversationMember[]
  messages         Message[]
  reportsMade      Report[]         @relation("reporter")
  reportsReceived  Report[]         @relation("reported")
  notifications    Notification[]
  loyaltyEntries   LoyaltyEntry[]
  alternativeOffers AlternativeOffer[]
  shareLinks       ShareLink[]
  articles         Article[]
  legalAcceptances LegalAcceptance[]
  authIdentities   AuthIdentity[]
  pushTokens       PushToken[]
}

// Compte externe relié (Google) : identifiant stable du fournisseur (« sub »), jamais l'adresse e-mail
// seule, qui peut changer chez le fournisseur.
model AuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())
  @@unique([provider, subject])
  @@index([userId])
}

// Code de connexion à usage unique envoyé par e-mail (10 minutes, 5 essais) : seule son empreinte est
// conservée, jamais le code en clair.
model EmailLoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([email, createdAt])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate       DateTime?
  city            String?
  profession      String?
  interests       String[]
  bio             String?
  photoUrl        String?
  // Code personnel lisible et dictable en soirée (« NOUR-3F9A-C21B-07E4 », 48 bits tirés de
  // gen_random_uuid, générateur cryptographique), jamais un identifiant technique ni devinable.
  shareCode       String   @unique @default(dbgenerated("((((('NOUR-'::text || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 4))) || '-'::text) || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 4))) || '-'::text) || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 4)))"))
  profileCompleted Boolean @default(false)
  quotaCategory   QuotaCategory?
  validatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Restaurant {
  id               String           @id @default(cuid())
  ownerId          String           @unique
  owner            User             @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff            User[]           @relation("StaffOf")
  name             String
  siret            String?
  managerName      String?
  description      String?
  district         String?
  address          String?
  phone            String?
  // Part de Nour en % sur les ventes des événements que ce restaurant organise commercialement
  // (30 par défaut = règle 30/70). Modifiable uniquement par le super-admin, jamais par le
  // restaurateur. Sans effet sur les événements organisés par Nour où ce restaurant n'est que le
  // lieu d'accueil (accord commercial distinct, non automatique).
  commissionRate   Int              @default(30)
  status           RestaurantStatus @default(PENDING)
  submittedAt      DateTime         @default(now())
  verifiedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  controlledEvents Event[]          @relation("Controller")
  hostedEvents     Event[]          @relation("Venue")
  ledgerEntries    LedgerEntry[]
  // Champs enrichis de la candidature restaurateur (§8.1) : renseignés à la demande, modifiables
  // ensuite depuis l'espace restaurateur. Tous facultatifs pour ne jamais bloquer une candidature
  // existante lors de la migration.
  desiredCapacity          Int?
  desiredSchedule          String?
  averagePricePerPersonCents Int?
  defaultMinParticipants   Int?
  priceIncludesDrink       Boolean  @default(false)
  priceIncludesStarter     Boolean  @default(false)
  priceIncludesMain        Boolean  @default(false)
  priceIncludesDessert     Boolean  @default(false)
  priceNotes               String?
  proposesCategoryPricing  Boolean  @default(false)
  allowsPrivatization      Boolean  @default(false)
  specialConditions        String?
  // Notes internes visibles uniquement par l'administration, jamais par le restaurateur.
  adminNotes               String?
  // Restaurant de démonstration (lancement) : présenté exactement comme un vrai restaurant, mais
  // aucun paiement n'est jamais possible sur ses événements (voir Event.isDemo, contrôlé côté API).
  isDemo                   Boolean  @default(false)
  photos                   RestaurantPhoto[]
  subscription             RestaurantSubscription?
  connectedAccount         ConnectedAccount?
  monthlyUsages            RestaurantMonthlyUsage[]
  @@map("Organizer")
}

// Galerie de la candidature/fiche restaurateur (§8.1), distincte de EventPhoto (galerie d'un
// événement précis).
model RestaurantPhoto {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  url          String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
}

model Event {
  id                      String      @id @default(cuid())
  slug                    String      @unique
  controllerRestaurantId  String?     @map("organizerId")
  controllerRestaurant    Restaurant? @relation("Controller", fields: [controllerRestaurantId], references: [id])
  venueRestaurantId       String?
  venueRestaurant         Restaurant? @relation("Venue", fields: [venueRestaurantId], references: [id])
  title                   String
  category                String
  flow                    EventFlow   @default(DIRECT)
  imageUrl                String?
  description             String
  startsAt                DateTime
  endsAt                  DateTime
  district                String
  address                 String
  zone                    String?
  minAge                  Int?
  maxAge                  Int?
  capacity                Int
  priceCents              Int
  // Prestations réellement incluses avec le billet (choix prédéfinis) : ne jamais en afficher
  // une comme incluse sur la fiche publique si le champ correspondant n'est pas à true.
  includesDrink           Boolean     @default(false)
  includesStarter         Boolean     @default(false)
  includesMain            Boolean     @default(false)
  includesDessert         Boolean     @default(false)
  perksDescription        String?
  status                  EventStatus @default(DRAFT)
  submittedForReviewAt    DateTime?
  reviewedAt              DateTime?
  reviewNote              String?
  // Un changement de date proposé alors qu'au moins un participant a déjà payé ou est bloqué
  // reste une simple proposition tant que le super-admin ne l'a pas approuvée (voir §4).
  proposedStartsAt        DateTime?
  proposedEndsAt          DateTime?
  dateChangeRequestedAt   DateTime?
  // Quota mensuel restaurateur (§8.2) : posé une seule fois, à la première publication, jamais
  // à la création d'un brouillon. Reste tel quel même si l'événement est ensuite annulé ou
  // supprimé, sauf remise à zéro explicite par un administrateur.
  quotaConsumedAt         DateTime?
  // Minimum de participants (§10) : facultatif, mais la date limite devient obligatoire dès qu'un
  // minimum est défini (contrôlé côté serveur, voir la route de création/modification).
  minParticipants           Int?
  minParticipantsDeadline   DateTime?
  minParticipantsNotifiedAt DateTime?
  minParticipantsOutcome    MinParticipantsOutcome?
  minParticipantsDecidedAt  DateTime?
  minParticipantsDecidedBy  String?
  // Événement de démonstration (lancement) : consultable et le parcours peut commencer, mais toute
  // tentative de paiement est refusée côté serveur (POST /applications/:id/payment-intent), jamais
  // seulement masquée dans l'interface. Aucune mention « démo » n'est affichée publiquement.
  isDemo                  Boolean     @default(false)
  // Publication Instagram d'un événement restaurateur (v2 §14) : une seule fois, au premier passage réel
  // à PUBLISHED ; identifiant du média, date, verrou d'envoi et dernière erreur (jamais bloquante).
  instagramMediaId        String?
  instagramPublishedAt    DateTime?
  instagramPublishingAt   DateTime?
  instagramError          String?
  // Publication sur la Page Facebook au premier passage réel à PUBLISHED (mêmes règles qu'Instagram).
  facebookPostId          String?
  facebookPublishedAt     DateTime?
  facebookPublishingAt    DateTime?
  facebookError           String?
  applications            Application[]
  callSlots               ScreeningCall[]
  reservations            Reservation[]
  waitlist                WaitlistEntry[]
  quotas                  EventQuota[]
  priceTiers              PriceTier[]
  photos                  EventPhoto[]
  ledgerEntries           LedgerEntry[]
  originalOffers          AlternativeOffer[] @relation("OriginalEvent")
  alternativeOffers       AlternativeOffer[] @relation("AlternativeEvent")
  shareLinks              ShareLink[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model EventQuota {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category  QuotaCategory
  capacity  Int
  heldCount Int           @default(0)
  @@unique([eventId, category])
}

// Tarif différencié par catégorie (ex. homme/femme), indépendant des quotas. Un événement sans
// ligne ici garde un tarif unique (Event.priceCents) — la différenciation est donc toujours
// facultative, jamais automatique, conformément à la vérification juridique encore à réaliser.
model PriceTier {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category  QuotaCategory
  amountCents Int
  @@unique([eventId, category])
}

// Galerie complémentaire à la photo principale (Event.imageUrl) : jusqu'à 5 photos additionnelles.
model EventPhoto {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

// Une ligne sans eventId représente l'entretien global de validation du profil (un seul entretien
// à la fois par personne ; plusieurs lignes possibles dans le temps si un refus a été suivi d'une
// nouvelle demande après le délai de carence). Une ligne avec eventId représente l'inscription
// directe (sans entretien ni décision manuelle) d'un profil déjà validé à un événement précis.
model Application {
  id          String            @id @default(cuid())
  eventId     String?
  userId      String
  event       Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  motivation  String?
  notes       String?
  status      ApplicationStatus @default(PENDING_CALL)
  quotaCategory QuotaCategory?
  decidedAt   DateTime?
  call        ScreeningCall?
  reservation Reservation?
  waitlistEntry WaitlistEntry?
  screeningAnswer   ScreeningAnswer?
  networkingAnswer  NetworkingAnswer?
  // Partage attribué (§12) : jamais révélé publiquement, seulement à l'administration (statistiques
  // de conversion). Posé à la candidature à partir du code présent dans l'URL au moment de la
  // visite, jamais recalculé après coup.
  attributedShareLinkId String?
  attributedShareLink    ShareLink?        @relation(fields: [attributedShareLinkId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@unique([eventId, userId])
}

// Lien de partage "J'y vais, viens avec moi" (§12) : un code non sensible par (personne, événement).
// Le clic est comptabilisé ici ; l'inscription et l'achat attribués se lisent depuis les
// Application liées (attributedShareLinkId), jamais l'inverse. L'identité de la personne qui a
// partagé n'est jamais exposée publiquement, uniquement dans les statistiques d'administration.
model ShareLink {
  id        String        @id @default(cuid())
  code      String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clicks    Int           @default(0)
  createdAt DateTime      @default(now())
  applications Application[]
  @@unique([userId, eventId])
}

enum TestimonialStatus {
  DRAFT
  PUBLISHED
}

// Témoignage (§17) : jamais publié automatiquement, même soumis par un participant — un
// administrateur doit explicitement passer le statut à PUBLISHED.
model Testimonial {
  id                String            @id @default(cuid())
  displayName       String
  eventType         String
  text              String
  rating            Int?
  status            TestimonialStatus @default(DRAFT)
  position          Int               @default(0)
  consentGiven      Boolean           @default(false)
  submittedByUserId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// Questionnaire speed dating (7 questions, §4.1 du cahier des charges) : privé, jamais accessible
// à un restaurateur ni exposé sur une route publique. Sert à préparer l'entretien, décider de
// l'acceptation et organiser les profils — jamais à bloquer le paiement une fois le profil validé.
model ScreeningAnswer {
  id                  String      @id @default(cuid())
  applicationId       String      @unique
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  motivation          String
  relationshipGoal    String
  personality         String
  desiredQualities    String
  ageRangeSought       String
  valuesAndLifestyle  String
  noteForOrganizer    String?
  createdAt           DateTime    @default(now())
}

// Questionnaire networking (7 questions, §4.2) : ne bloque jamais l'achat, sert uniquement à mieux
// organiser la soirée et à informer l'organisateur (jamais les réponses privées d'un speed dating).
model NetworkingAnswer {
  id               String      @id @default(cuid())
  applicationId    String      @unique
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sector           String
  currentRole      String
  experienceLevel  String
  goal             String
  soughtProfiles   String
  contribution     String
  topics           String
  createdAt        DateTime    @default(now())
}

// Agenda central : un créneau sans eventId appartient à l'agenda global des entretiens de
// validation de profil (un seul entretien possible à la fois sur toute la plateforme). Les
// créneaux historiques déjà rattachés à un événement restent inchangés.
model ScreeningCall {
  id            String       @id @default(cuid())
  eventId       String?
  applicationId String?      @unique
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  completedAt   DateTime?
  notes         String?

  @@index([startsAt])
}

// Calendrier des entretiens (v2 §11) : ouvert par défaut de 10h à 22h ; l'équipe ferme des périodes.
// Une plage bloquée ne déplace ni n'annule jamais un rendez-vous déjà réservé (ScreeningCall).
model InterviewBlock {
  id          String   @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([startsAt, endsAt])
}

model Reservation {
  id            String       @id @default(cuid())
  eventId       String
  userId        String
  applicationId String       @unique
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application  @relation(fields: [applicationId], references: [id])
  quotaCategory QuotaCategory?
  expiresAt     DateTime
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  // §13 : posé au moment où le rappel avant événement est envoyé, jamais avant — garantit l'envoi
  // une seule fois par réservation confirmée (voir sendEventReminders côté API).
  reminderSentAt DateTime?
  // §3 (cahier des charges 2026-09) : second rappel, plus proche de l'événement, en plus du rappel
  // J-1 ci-dessus (reminderSentAt) — les deux sont indépendants et idempotents.
  reminderH2SentAt DateTime?
  payment       Payment?
  ticket        Ticket?
  alternativeOffer AlternativeOffer?
  createdAt     DateTime     @default(now())
  @@unique([eventId, userId])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  provider      String        @default("fake")
  providerRef   String?
  paidAt        DateTime?
  refundedAt    DateTime?
  refundedAmountCents   Int?
  // Motif renseigné uniquement quand un remboursement est accordé HORS politique (annulation à 24h
  // ou moins de l'événement, §7) : c'est alors une exception admin, jamais un remboursement de plein
  // droit ; obligatoire dans ce cas précis, absent pour un remboursement automatique conforme.
  refundExceptionReason String?
  // Le restaurateur peut DEMANDER un remboursement avec un motif ; seul le super-admin peut
  // l'exécuter (POST /admin/payments/:id/refund). Une demande n'exécute jamais rien seule.
  refundRequestedAt     DateTime?
  refundRequestedBy     String?
  refundRequestReason   String?
  ledgerEntry   LedgerEntry?
  createdAt     DateTime      @default(now())
}

// Comptabilité 30/70 : une ligne par vente réussie sur un événement organisé commercialement par un
// restaurant (jamais pour les événements organisés par Nour où le restaurant n'est que le lieu).
// Le taux et les montants sont figés au moment de la vente (snapshot), indépendants d'un changement
// ultérieur du taux du restaurant. Aucun virement réel n'est jamais déclenché par la plateforme :
// "Marquer comme reversé" n'est qu'un registre manuel que seul le super-admin peut cocher, à
// n'importe quel moment de son choix — jamais automatiquement, jamais par le restaurateur.
model LedgerEntry {
  id                    String     @id @default(cuid())
  paymentId             String     @unique
  payment               Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventId               String
  event                 Event      @relation(fields: [eventId], references: [id])
  restaurantId          String
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id])
  grossAmountCents      Int
  commissionRate        Int
  commissionAmountCents Int
  restaurantDueCents    Int
  stripeFeeCents        Int?
  refundedAmountCents   Int        @default(0)
  paidOutAt             DateTime?
  paidOutBy             String?
  payoutNote            String?
  createdAt             DateTime   @default(now())
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String       @unique
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  code          String       @unique
  status        TicketStatus @default(VALID)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
}

model WaitlistEntry {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  applicationId String   @unique
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id])
  quotaCategory QuotaCategory?
  position      Int
  offeredAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  @@unique([eventId, userId])
}

model AlternativeOffer {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalEventId    String
  originalEvent      Event                  @relation("OriginalEvent", fields: [originalEventId], references: [id], onDelete: Cascade)
  alternativeEventId String
  alternativeEvent   Event                  @relation("AlternativeEvent", fields: [alternativeEventId], references: [id], onDelete: Cascade)
  status             AlternativeOfferStatus @default(PENDING)
  respondsBy         DateTime
  reservationId      String?                @unique
  reservation        Reservation?           @relation(fields: [reservationId], references: [id])
  createdAt          DateTime               @default(now())
  respondedAt        DateTime?
}

model ContactRequest {
  id          String               @id @default(cuid())
  requesterId String
  recipientId String
  requester   User                 @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                 @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      ContactRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@unique([requesterId, recipientId])
}

model Conversation {
  id        String               @id @default(cuid())
  members   ConversationMember[]
  messages  Message[]
  createdAt DateTime             @default(now())
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  blockedAt      DateTime?
  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String?
  imageUrl       String?
  createdAt      DateTime     @default(now())
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User         @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  // C14 (ordre correctif 2026-09-20) : chemin frontend exact vers l'objet métier concerné (une
  // soirée, un billet, un entretien, l'abonnement...), jamais un lien générique. Null uniquement
  // pour les notifications qui n'ont réellement aucune destination plus précise que l'espace lui-même.
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model LoyaltyEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

// Statut réel d'un message : QUEUED tant qu'aucun fournisseur n'a réellement tenté l'envoi (jamais
// affiché comme "envoyé" côté interface), SENT seulement après acceptation confirmée par le
// fournisseur, FAILED en cas d'échec d'envoi (avec le motif dans `error`).
enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}
model OutboxMessage {
  id        String       @id @default(cuid())
  channel   String
  recipient String
  subject   String?
  body      String
  status    OutboxStatus @default(QUEUED)
  sentAt    DateTime?
  error     String?
  createdAt DateTime     @default(now())
}

// Mesure d'audience (C32-C34, ordre correctif 2026-09-20) : première partie, anonyme, jamais un
// identifiant tiers/publicitaire. anonId est un identifiant aléatoire posé côté navigateur
// (localStorage), jamais une empreinte ni une donnée personnelle ; userId n'est renseigné que si le
// visiteur est déjà connecté (corrélation avec son propre compte, jamais un nouveau traçage).
// Désactivé par défaut (AppSetting ANALYTICS_ENABLED) : ne jamais collecter silencieusement — voir
// settings.ts pour la mise en garde légale avant activation en production.
// Cahier des charges consolidé final (2026-09-20, section 9.2) : jamais le jeton de session
// (30 jours) dans l'URL de paiement ouverte depuis le navigateur intégré mobile — un jeton aussi
// long durerait dans l'historique du navigateur. Ce jeton opaque à usage unique et à courte durée
// de vie sert uniquement à l'échanger contre un vrai jeton de session, éphémère, une fois la page
// de paiement web ouverte (voir POST /auth/payment-session-exchange).
model PaymentSession {
  id            String    @id @default(cuid())
  token         String    @unique
  userId        String
  applicationId String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

model PageView {
  id           String   @id @default(cuid())
  path         String
  anonId       String
  userId       String?
  userRole     String?
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime @default(now())
  @@index([createdAt])
  @@index([anonId])
}

// Paramètres applicatifs centralisés (voir src/settings.ts) : toute valeur "provisoire" du cahier
// des charges (verrou de paiement, quota mensuel restaurateur, drapeaux de fonction...) vit ici,
// jamais en dur dans le code. Une clé absente retombe sur sa valeur par défaut codée dans
// settings.ts, donc l'absence de ligne n'est jamais une erreur.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Remplace le modèle 30/70 (§8.2) : un restaurateur paie un abonnement mensuel plutôt qu'une
// commission par vente. Le taux de commission et les LedgerEntry existants restent en base
// (jamais effacés), mais aucune nouvelle ligne n'est créée par défaut — voir ENABLE_COMMISSION_LEDGER
// dans settings.ts.
model Plan {
  id                String                   @id @default(cuid())
  name              String
  monthlyPriceCents Int
  // Instructions définitives 2026-09-20 : prix annuel FIXE (2 mois offerts, -16,67 %), plus une
  // valeur dérivée à -20 % — remplace l'ancien calcul automatique. Null uniquement pour une formule
  // qui n'offre pas encore de facturation annuelle.
  annualPriceCents  Int?
  // §7 (cahier des charges 2026-09) : null = illimité (formule Premium).
  monthlyEventQuota Int?
  // Instructions définitives 2026-09-20 : mise en avant réelle (accueil / classement), jamais
  // seulement mentionnée dans un texte commercial. "simple" ou "priority" ; null = aucune.
  highlightTier     String?
  stripePriceMonthlyId String?
  stripePriceAnnualId  String?
  active            Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  subscriptions     RestaurantSubscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model RestaurantSubscription {
  id                   String             @id @default(cuid())
  restaurantId         String             @unique
  restaurant           Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  // Instructions définitives 2026-09-20 : abonnement réel via Stripe Billing (mode TEST), plus une
  // simulation de statut. billingPeriod choisi au moment du checkout (mensuel ou annuel).
  billingPeriod        String             @default("MONTHLY")
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelledAt          DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // §3 (cahier des charges 2026-09) : rappel envoyé une seule fois par période avant l'échéance de
  // l'abonnement. Comparé à currentPeriodStart (pas seulement non-null) pour redevenir envoyable dès
  // qu'une nouvelle période démarre.
  expiryReminderSentAt DateTime?
  // Changement de formule vers une formule inférieure (Premium → Standard) : la formule actuelle reste
  // acquise jusqu'à la fin de la période déjà payée, la nouvelle s'applique à l'échéance via un
  // calendrier d'abonnement Stripe (stripeScheduleId). pendingPlanId/pendingChangeAt ne servent qu'à
  // l'affichage et sont effacés par le webhook dès que Stripe a réellement basculé la formule.
  pendingPlanId        String?
  // Périodicité programmée avec pendingPlanId (passage annuel → mensuel, ou baisse de formule en
  // changeant aussi de périodicité) ; nulle = périodicité actuelle conservée.
  pendingBillingPeriod String?
  pendingChangeAt      DateTime?
  stripeScheduleId     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// Un événement ne consomme le quota mensuel qu'à sa toute première publication (Event.quotaConsumedAt),
// jamais à la création d'un brouillon ; annuler ou supprimer l'événement ensuite ne rend jamais
// automatiquement le quota (seule une action explicite d'un administrateur le peut, voir
// POST /admin/events/:id/refund-quota).
model RestaurantMonthlyUsage {
  id              String     @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  yearMonth       String
  eventsPublished Int        @default(0)
  @@unique([restaurantId, yearMonth])
}

// Scaffolding marketplace (§9), compatible Stripe Connect : suivi d'un compte connecté en
// environnement de TEST uniquement. Aucun virement réel n'est jamais déclenché par la plateforme —
// voir MARKETPLACE_PAYOUTS_ENABLED (désactivé par défaut) dans settings.ts. L'activation en
// production reste bloquée par une validation juridique du modèle (vendeur contractuel,
// responsabilité) non encore réalisée.
enum ConnectedAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  REJECTED
}
model ConnectedAccount {
  id                String                 @id @default(cuid())
  restaurantId      String                 @unique
  restaurant        Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  provider          String                 @default("stripe")
  externalAccountId String
  status            ConnectedAccountStatus @default(PENDING)
  createdAt         DateTime               @default(now())
}

// Blog éditorial (§18) : socle éditorial d'abord, jamais de génération autonome en production.
// Un brouillon généré par IA (aiGenerated=true) suit exactement le même circuit de validation
// qu'un article écrit à la main — aucun statut ne permet de le publier sans passage explicite par
// un administrateur (voir POST /admin/articles/:id/decision puis /publish).
enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Article {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  excerpt         String?
  content         String
  imageUrl        String?
  category        String
  keywords        String[]
  metaTitle       String?
  metaDescription String?
  authorId        String?
  author          User?             @relation(fields: [authorId], references: [id])
  status          ArticleStatus     @default(DRAFT)
  // Programmation : publiée automatiquement par le balayage périodique une fois cette date atteinte,
  // seulement si le statut est déjà APPROVED (jamais depuis DRAFT ou IN_REVIEW).
  scheduledAt     DateTime?
  publishedAt     DateTime?
  archivedAt      DateTime?
  aiGenerated     Boolean           @default(false)
  aiPrompt        String?
  // Publication automatique quotidienne (production) : jour calendaire (Europe/Paris, "AAAA-MM-JJ")
  // de l'article généré par la tâche de fond. L'unicité garantit au niveau de la base qu'un seul
  // article automatique existe par jour, même si deux passages de la tâche se chevauchent.
  autoPublishDay  String?           @unique
  // Couverture générée par IA (OpenAI) après contrôle automatique par Claude : le site affiche alors
  // « Illustration générée par IA », jamais une image présentée comme une photo réelle.
  imageAiGenerated Boolean          @default(false)
  // Publication Instagram automatique de l'article du jour : identifiant du média publié (garantit une
  // seule publication par article), date, légende utilisée et dernière erreur éventuelle.
  instagramCaption     String?
  instagramMediaId     String?
  instagramPublishedAt DateTime?
  instagramError       String?
  // Verrou de publication (v2 §6) : posé atomiquement avant l'envoi à Instagram, pour qu'un nouvel essai
  // manuel et la tâche automatique ne publient jamais deux fois le même carrousel.
  instagramPublishingAt DateTime?
  // Publication sur la Page Facebook (même carrousel qu'Instagram) : identifiant, date, verrou, erreur.
  facebookPostId       String?
  facebookPublishedAt  DateTime?
  facebookPublishingAt DateTime?
  facebookError        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reviewLogs      ArticleReviewLog[]
}

// File d'attente éditoriale (§5, 2026-09) : réserve d'articles déjà rédigés (qualité éditoriale,
// jamais un brouillon générique IA) qui n'existent pas encore comme Article — et donc n'apparaissent
// pas encore dans l'espace admin — jusqu'à ce que releaseQueuedArticle() en fasse passer un par jour,
// une fois en production, dans la table Article au statut DRAFT pour relecture. position détermine
// l'ordre de sortie (le plus petit sort le premier).
model ArticleQueueEntry {
  id              String   @id @default(cuid())
  position        Int
  title           String
  slug            String
  excerpt         String
  content         String
  category        String
  keywords        String[]
  metaTitle       String
  metaDescription String
  imageUrl        String?
  createdAt       DateTime @default(now())
}

// Ligne unique (id fixe "singleton") qui mémorise la dernière date de sortie automatique, pour que
// releaseQueuedArticle() reste idempotent (un seul article libéré par jour) même après un redémarrage
// du serveur entre deux passages du cron.
model ArticleQueueState {
  id             String    @id @default("singleton")
  lastReleasedAt DateTime?
}

// Journal de validation (§18) : une ligne par changement de statut, jamais effacée.
model ArticleReviewLog {
  id         String        @id @default(cuid())
  articleId  String
  article    Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actorId    String?
  fromStatus ArticleStatus
  toStatus   ArticleStatus
  note       String?
  createdAt  DateTime      @default(now())
}

// Preuve d'acceptation des CGU/CGV (quoi, quelle version, quand, depuis où). Jamais modifiée ni
// supprimée, y compris lors d'une suppression de compte : c'est une preuve contractuelle, au même
// titre que Payment. "context" précise l'occasion (ex. "profile", "application:<id>").
model LegalAcceptance {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  document   LegalDocument
  version    String
  context    String
  ip         String?
  userAgent  String?
  acceptedAt DateTime      @default(now())

  @@index([userId, document, version])
}

enum LegalDocument {
  CGU
  CGV
}

// Jeton d'accès d'un réseau social (Instagram : valable 60 jours) renouvelé automatiquement par le
// serveur. La valeur initiale vient de l'environnement (INSTAGRAM_ACCESS_TOKEN) ; chaque jeton renouvelé
// est conservé ici pour survivre aux redémarrages. Jamais exposé par une route de l'API.
model SocialCredential {
  provider    String   @id
  accessToken String
  expiresAt   DateTime?
  refreshedAt DateTime @default(now())
}

// Connexion Google depuis l'application mobile (2026-09-24) : la connexion a lieu sur le site, dans le
// navigateur intégré, puis l'application récupère sa session grâce à ce code à usage unique (2 minutes),
// renvoyé uniquement vers le schéma de l'application. Jamais le jeton de session dans une URL.
model LoginHandoff {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  challenge String
  userId    String
  isNewUser Boolean   @default(false)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Notifications push de l'application mobile (2026-09-24) : un jeton Expo par appareil. Un même
// appareil passant d'un compte à l'autre est réattribué (token unique) ; supprimé à la déconnexion,
// à l'anonymisation du compte, ou quand Expo signale que l'application a été désinstallée.
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  @@index([userId])
}
