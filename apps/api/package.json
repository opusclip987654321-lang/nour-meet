{
  "name": "@nour/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cluster-entry.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "typecheck:integration": "tsc -p tests/tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx prisma/seed-demo.ts",
    "stripe:setup-test-plans": "tsx prisma/stripe-test-plans.ts",
    "admin:grant": "tsx prisma/grant-admin.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@nour/shared": "1.0.0",
    "@prisma/client": "6.19.0",
    "@sentry/node": "^10.75.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "stripe": "^22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "6.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
