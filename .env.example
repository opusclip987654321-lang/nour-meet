DATABASE_URL=postgresql://USER:CHANGE_ME@localhost:5432/nour_meet?schema=public
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
SMS_MODE=mock
DEV_OTP_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Stripe (mode TEST — clés à récupérer sur dashboard.stripe.com, jamais commitées)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Resend (envoi d'e-mail réel — resend.com/api-keys). Laisser vide pour garder l'envoi simulé.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Sentry (surveillance d'erreurs — sentry.io, formule gratuite). Laisser vide pour rester désactivé.
SENTRY_DSN=
VITE_SENTRY_DSN=
