# Modèle pour la préproduction — copier en ".env.staging" à côté de docker-compose.staging.yml,
# JAMAIS commiter le fichier rempli, JAMAIS réutiliser les valeurs de production.

POSTGRES_USER=nour
POSTGRES_PASSWORD=
POSTGRES_DB=nour_meet_staging

JWT_SECRET=

SMS_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

WEB_ORIGIN=http://localhost:8081
VITE_API_URL=http://localhost:4001

# Toujours des clés TEST ici, jamais LIVE.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Nom affiché comme expéditeur (optionnel), ex. Nūr Meet
RESEND_FROM_NAME=

SENTRY_DSN=
VITE_SENTRY_DSN=

# Article quotidien du blog généré par Claude (recherche web). Vide : repli sur la réserve d’articles.
ANTHROPIC_API_KEY=
# Adresse publique du site, ex. https://nourmeet.com (liens canoniques, Open Graph)
VITE_SITE_URL=

# Illustrations IA de l'article du jour (OpenAI Images) et publication Instagram automatique.
# Laisser vide : photothèque du site, aucune publication Instagram.
OPENAI_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Publication automatique sur la Page Facebook (vide : aucune publication Facebook).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Connexion avec Google : identifiant client OAuth (Google Cloud Console). Vide : bouton masqué.
GOOGLE_CLIENT_ID=
