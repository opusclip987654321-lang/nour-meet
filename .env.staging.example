# Modèle pour la préproduction — copier en ".env.staging" à côté de docker-compose.staging.yml,
# JAMAIS commiter le fichier rempli, JAMAIS réutiliser les valeurs de production.

POSTGRES_USER=nour
POSTGRES_PASSWORD=
POSTGRES_DB=nour_meet_staging

JWT_SECRET=

SMS_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

WEB_ORIGIN=http://localhost:8081
VITE_API_URL=http://localhost:4001

# Toujours des clés TEST ici, jamais LIVE.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Nom affiché comme expéditeur (optionnel), ex. Nūr Meet
RESEND_FROM_NAME=

SENTRY_DSN=
VITE_SENTRY_DSN=
