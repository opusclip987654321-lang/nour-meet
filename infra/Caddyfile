# Reverse proxy de production : HTTPS automatique (Let's Encrypt), renouvellement automatique,
# redirection HTTP -> HTTPS automatique dès qu'un domaine (et non une adresse IP/scheme http://)
# est utilisé comme nom de bloc, ce qui est le cas ici pour les trois domaines.
#
# Variables substituées depuis l'environnement du conteneur (voir docker-compose.prod.yml) :
# DOMAIN_WEB (ex. nourmeet.com), DOMAIN_API (ex. api.nourmeet.com), ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

{$DOMAIN_WEB} {
	encode zstd gzip
	# Fichiers de référencement générés par l'API à partir des données réelles (corrections web
	# 2026-09-24, §19) : servis sur le domaine du site, comme les moteurs de recherche l'attendent.
	@seo path /sitemap.xml /robots.txt /llms.txt
	handle @seo {
		reverse_proxy api:4000
	}
	# Agent vidéo : fichiers publics téléchargés par Instagram/Facebook lors de la publication.
	handle_path /va/* {
		root * /srv/va
		file_server
	}

	handle {
		reverse_proxy web:80
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
}

www.{$DOMAIN_WEB} {
	redir https://{$DOMAIN_WEB}{uri} permanent
}

{$DOMAIN_API} {
	reverse_proxy api:4000
	encode zstd gzip
	header -Server
}

n8n.nourmeet.com {
	reverse_proxy n8n:5678
	encode gzip
}

# Sites Leviaro servis par le même Caddy (seul à écouter sur 80/443 sur ce serveur) : ajoutés à la main en
# production le 2026-10, reportés ici pour que deploy.sh ne bloque plus sur un Caddyfile modifié.
admin.leviaro.fr {
	reverse_proxy leviaro-agent-web-1:8787
}

leviaro.fr, www.leviaro.fr {
	reverse_proxy leviaro-site:80
}

# Cerveau central : ajouté à la main en production, reporté ici pour que le Caddyfile suivi corresponde au serveur.
cerveau.nourmeet.com {
	reverse_proxy cerveau-central:8090
}

# VégéBudget (dépôt v-g-budget, conteneur « vegebudget » dans /opt/vegebudget, joint par le réseau nour-v2_default).
vegebudget.fr {
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	reverse_proxy vegebudget:3000
}

www.vegebudget.fr {
	redir https://vegebudget.fr{uri} permanent
}
