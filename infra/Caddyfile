# Reverse proxy de production : HTTPS automatique (Let's Encrypt), renouvellement automatique,
# redirection HTTP -> HTTPS automatique dès qu'un domaine (et non une adresse IP/scheme http://)
# est utilisé comme nom de bloc, ce qui est le cas ici pour les trois domaines.
#
# Variables substituées depuis l'environnement du conteneur (voir docker-compose.prod.yml) :
# DOMAIN_WEB (ex. nourmeet.com), DOMAIN_API (ex. api.nourmeet.com), ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

{$DOMAIN_WEB} {
	encode zstd gzip
	# Fichiers de référencement générés par l'API à partir des données réelles (corrections web
	# 2026-09-24, §19) : servis sur le domaine du site, comme les moteurs de recherche l'attendent.
	@seo path /sitemap.xml /robots.txt /llms.txt
	handle @seo {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:80
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
}

www.{$DOMAIN_WEB} {
	redir https://{$DOMAIN_WEB}{uri} permanent
}

{$DOMAIN_API} {
	reverse_proxy api:4000
	encode zstd gzip
	header -Server
}

n8n.nourmeet.com {
	reverse_proxy n8n:5678
	encode gzip
}
