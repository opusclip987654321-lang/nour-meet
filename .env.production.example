# Modèle pour la production — copier en ".env" à côté de docker-compose.prod.yml sur le serveur,
# JAMAIS commiter le fichier rempli. Chaque valeur ci-dessous doit être une vraie valeur de
# production, pas une valeur de développement recopiée.

# --- Base de données ---
POSTGRES_USER=nour
# Générer un mot de passe long et aléatoire dédié à la production, jamais celui du dev local.
POSTGRES_PASSWORD=
POSTGRES_DB=nour_meet

# --- Sécurité applicative ---
# Générer avec: openssl rand -hex 32 — jamais réutiliser un secret de dev/test.
JWT_SECRET=

# --- SMS (OTP de connexion) ---
# mock est bloqué en production par apps/api/src/env.ts : il faut un vrai fournisseur (Twilio Verify).
SMS_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Domaines réels (jamais localhost) ---
WEB_ORIGIN=https://nourmeet.com
VITE_API_URL=https://api.nourmeet.com

# --- Reverse proxy / HTTPS automatique (Caddy) ---
DOMAIN_WEB=nourmeet.com
DOMAIN_API=api.nourmeet.com
# Adresse recevant les alertes Let's Encrypt (ex. expiration de certificat) — pas forcément une
# adresse @nourmeet.com si la messagerie du domaine n'est pas encore active.
ACME_EMAIL=

# --- Stripe ---
# Ne basculer sur les clés LIVE (sk_live_/whsec_ réel/pk_live_) qu'après accord explicite : tant
# que ce sont des clés sk_test_/pk_test_, aucun vrai paiement n'est prélevé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- E-mail transactionnel (Resend) ---
# Laisser vide pour garder l'envoi simulé (aucun e-mail réel n'est envoyé sans ces deux valeurs).
# Utiliser un expéditeur sur un sous-domaine dédié (ex. notifications@mail.nourmeet.com), jamais
# l'adresse de la messagerie professionnelle OVH du domaine principal — voir le rapport pour le
# détail des enregistrements DNS à ajouter chez OVH sans toucher au MX existant.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Nom affiché comme expéditeur (optionnel), ex. Nūr Meet
RESEND_FROM_NAME=

# --- Surveillance d'erreurs (Sentry, formule gratuite) ---
# Laisser vide pour rester désactivé (aucun envoi à un tiers).
SENTRY_DSN=
VITE_SENTRY_DSN=
