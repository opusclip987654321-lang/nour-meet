# Modèle pour la production — copier en ".env" à côté de docker-compose.prod.yml sur le serveur,
# JAMAIS commiter le fichier rempli. Chaque valeur ci-dessous doit être une vraie valeur de
# production, pas une valeur de développement recopiée.

# --- Base de données ---
POSTGRES_USER=nour
# Générer un mot de passe long et aléatoire dédié à la production, jamais celui du dev local.
POSTGRES_PASSWORD=
POSTGRES_DB=nour_meet

# --- Sécurité applicative ---
# Générer avec: openssl rand -hex 32 — jamais réutiliser un secret de dev/test.
JWT_SECRET=

# --- SMS (OTP de connexion) ---
# mock est bloqué en production par apps/api/src/env.ts : il faut un vrai fournisseur (Twilio Verify).
SMS_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Domaines réels (jamais localhost) ---
WEB_ORIGIN=https://votredomaine.fr
VITE_API_URL=https://api.votredomaine.fr

# --- Stripe ---
# Ne basculer sur les clés LIVE (sk_live_/whsec_ réel/pk_live_) qu'après accord explicite : tant
# que ce sont des clés sk_test_/pk_test_, aucun vrai paiement n'est prélevé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- E-mail transactionnel (Resend) ---
# Laisser vide pour garder l'envoi simulé (aucun e-mail réel n'est envoyé sans ces deux valeurs).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
