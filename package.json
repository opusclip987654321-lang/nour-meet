{
  "name": "nour-meet-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev -w @nour/api\" \"npm run dev -w @nour/web\"",
    "dev:api": "npm run dev -w @nour/api",
    "dev:web": "npm run dev -w @nour/web",
    "dev:mobile": "npm run start -w @nour/mobile",
    "build": "npm run build -w @nour/shared && npm run build -w @nour/api && npm run build -w @nour/web",
    "typecheck": "npm run build -w @nour/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @nour/api",
    "db:generate": "npm run prisma:generate -w @nour/api",
    "db:migrate": "npm run prisma:migrate -w @nour/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy -w @nour/api",
    "db:seed": "npm run prisma:seed -w @nour/api",
    "db:studio": "npm run prisma:studio -w @nour/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3"
  },
  "engines": {"node": ">=20"}
}
